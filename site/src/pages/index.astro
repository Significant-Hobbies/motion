---
import SiteLayout from "../layouts/SiteLayout.astro";
import { appStoreBadge, primaryCta } from "../lib/distribution";
import { site } from "../site.config";

const cta = primaryCta();
---
<SiteLayout>
  <section class="hero">
    <div class="hero-field" aria-hidden="true">
      <span class="lantern lantern-a"></span>
      <span class="lantern lantern-b"></span>
      <span class="lantern lantern-c"></span>
    </div>
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="hero-kicker">{site.kicker}</p>
        <h1><span style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0">{site.name}</span>{site.headline[0]}<br />{site.headline[1]}</h1>
        <p class="hero-lede">{site.lede}</p>
        <div class="hero-actions">
          {cta.kind === "app-store" ? (
            <a class="store-badge" href={cta.href}>
              <img src={appStoreBadge.src} width="160" height="54" alt={appStoreBadge.alt} />
            </a>
          ) : (
            <a class="button" href={cta.href}>{cta.label} <span aria-hidden="true">{cta.kind === "status" ? "→" : "↗"}</span></a>
          )}
          <a class="text-link" href="#look-inside">See the screens <span aria-hidden="true">↓</span></a>
        </div>
        <p class="beta-note">{site.betaNote}</p>
      </div>
      <figure class="hero-device">
        <div class="phone-shell">
          <img src={site.hero.image} width="660" height="1434" alt={site.hero.alt} fetchpriority="high" />
        </div>
        <figcaption>{site.hero.caption}</figcaption>
      </figure>
    </div>
  </section>

  <section id="look-inside" class="gallery" aria-labelledby="gallery-title">
    <div class="shell">
      <p class="chapter-kicker">Look inside</p>
      <h2 id="gallery-title">The real iPhone screens.</h2>
    </div>
    <div class="gallery-track">
      {site.gallery.map((shot) => (
        <figure class="gallery-phone">
          <div class="phone-shell">
            <img src={shot.src} width="390" height="844" alt={shot.alt} loading="lazy" decoding="async" />
          </div>
        </figure>
      ))}
    </div>
  </section>

  <section class="tension shell" aria-labelledby="tension-title">
    <p class="statement">{site.tension.statement}</p>
    <div class="tension-copy">
      <h2 id="tension-title">{site.tension.title}</h2>
      <p>{site.tension.copy}</p>
    </div>
  </section>

  <section id="how-it-works" class="chapters" aria-labelledby="chapters-title">
    <div class="shell chapter-intro">
      <div>
        <p class="chapter-kicker">{site.chaptersKicker}</p>
        <h2 id="chapters-title">{site.chaptersTitle}</h2>
      </div>
      <p>{site.chaptersLede}</p>
    </div>
    <div class="chapter-track">
      {site.chapters.map((chapter, index) => (
        <article class:list={["chapter", index % 2 === 1 && "chapter-reverse"]}>
          <div class="shell chapter-grid">
            <div class="chapter-copy">
              <p class="chapter-name">{chapter.name}</p>
              <h3>{chapter.title}</h3>
              <p>{chapter.copy}</p>
            </div>
            <figure class="screen-frame">
              <img src={chapter.image} width="660" height="1434" loading={index === 0 ? "eager" : "lazy"} decoding="async" alt={chapter.alt} />
            </figure>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="fit-section">
    <div class="shell fit-grid">
      <div>
        <p class="chapter-kicker">{site.fit.kicker}</p>
        <h2>{site.fit.title}</h2>
      </div>
      <div class="fit-copy">
        <p>{site.fit.yes}</p>
        <p>{site.fit.no}</p>
      </div>
    </div>
  </section>

  <section id="privacy" class="privacy-section" aria-labelledby="privacy-title">
    <div class="shell privacy-grid">
      <div class="privacy-mark" aria-hidden="true">
        <img src={site.mark} width="660" height="660" alt="" loading="lazy" decoding="async" />
      </div>
      <div>
        <p class="chapter-kicker">{site.privacy.kicker}</p>
        <h2 id="privacy-title">{site.privacy.title}</h2>
        <p>{site.privacy.copy}</p>
        <a class="text-link" href="/privacy/">Read the plain-language privacy policy <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="faq shell" aria-labelledby="faq-title">
    <h2 id="faq-title">A few honest answers.</h2>
    <div class="faq-list">
      {site.faqs.map((faq) => (
        <details>
          <summary>{faq.question}</summary>
          <p>{faq.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="founder-note">
    <div class="shell founder-grid">
      <blockquote>“{site.founder.quote}”</blockquote>
      <div>
        <p>{site.founder.credit}</p>
        <p>{site.founder.note}</p>
      </div>
    </div>
  </section>

  <section class="closing">
    <div class="shell">
      <div class="closing-lanterns" aria-hidden="true">
        <span class="lantern lantern-a"></span>
        <span class="lantern lantern-b"></span>
        <span class="lantern lantern-c"></span>
      </div>
      <div>
        <h2>{site.closingTitle[0]}<br />{site.closingTitle[1]}</h2>
        {cta.kind === "app-store" ? (
          <a class="store-badge" href={cta.href}>
            <img src={appStoreBadge.src} width="160" height="54" alt={appStoreBadge.alt} />
          </a>
        ) : (
          <a class="button" href={cta.href}>{cta.label} <span aria-hidden="true">{cta.kind === "status" ? "→" : "↗"}</span></a>
        )}
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .hero { position: relative; min-height: 820px; overflow: hidden; padding: 136px 0 80px; background: var(--field); }
  .hero-field { position: absolute; inset: 0; pointer-events: none; }
  .lantern { position: absolute; border-radius: 50%; filter: blur(0.2px); }
  .lantern-a { width: 220px; height: 220px; top: 18%; right: 12%; background: color-mix(in srgb, var(--lantern-a) 55%, transparent); }
  .lantern-b { width: 140px; height: 140px; top: 38%; right: 4%; background: color-mix(in srgb, var(--lantern-b) 62%, transparent); }
  .lantern-c { width: 96px; height: 96px; top: 52%; right: 22%; background: color-mix(in srgb, var(--lantern-c) 70%, transparent); }
  .hero-grid { position: relative; display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(300px, .78fr); align-items: center; gap: clamp(50px, 8vw, 118px); }
  .hero-copy { padding-top: 30px; }
  .hero-kicker { margin-bottom: 15px; color: var(--accent-dark); font-family: var(--display); font-size: clamp(1.05rem, 2vw, 1.35rem); font-weight: 760; }
  h1 { max-width: 10ch; font-size: clamp(4.2rem, 9vw, 7.2rem); line-height: .84; letter-spacing: -.038em; }
  .hero-lede { max-width: 34ch; margin-top: 32px; color: var(--ink-soft); font-size: clamp(1.1rem, 2vw, 1.34rem); line-height: 1.55; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 18px 25px; margin-top: 32px; }
  .text-link { display: inline-flex; min-height: 44px; gap: 7px; align-items: center; color: var(--ink); font-weight: 750; text-decoration-thickness: 1px; text-underline-offset: 5px; }
  .beta-note { margin-top: 14px; color: var(--ink-soft); font-size: .82rem; }
  .hero-device { align-self: end; justify-self: center; width: min(100%, 370px); }
  .phone-shell { overflow: hidden; padding: 8px; border-radius: 50px; background: var(--ink); box-shadow: 0 36px 80px color-mix(in srgb, var(--ink) 26%, transparent); transform: rotate(2.2deg); }
  .phone-shell img { width: 100%; height: auto; border-radius: 42px; }
  .hero-device figcaption { max-width: 30ch; margin: 18px auto 0; color: var(--ink-soft); font-size: .8rem; text-align: center; }
  .store-badge { display: inline-flex; min-height: 44px; align-items: center; }
  .store-badge img { height: 54px; width: auto; }
  .gallery { padding: 80px 0 40px; background: var(--paper); }
  .gallery h2 { font-size: clamp(2.6rem, 5vw, 4.6rem); letter-spacing: -.035em; line-height: .94; }
  .gallery-track { display: flex; gap: 22px; overflow-x: auto; scroll-snap-type: x mandatory; padding: 36px max(20px, calc((100% - 1180px) / 2 + 20px)) 56px; }
  .gallery-phone { flex: 0 0 min(260px, 72vw); scroll-snap-align: start; }
  .gallery-phone .phone-shell { transform: none; }
  .tension { display: grid; grid-template-columns: 1.15fr .65fr; gap: clamp(44px, 9vw, 130px); align-items: end; padding-top: 130px; padding-bottom: 130px; }
  .statement { font-family: var(--display); font-size: clamp(2.7rem, 6vw, 5.2rem); font-weight: 760; line-height: .96; letter-spacing: -.035em; }
  .tension-copy h2 { margin-bottom: 15px; font-size: 1.35rem; }
  .tension-copy p { color: var(--ink-soft); font-size: 1.04rem; line-height: 1.7; }
  .chapters { background: var(--field); }
  .chapter-intro { display: grid; grid-template-columns: 1fr .58fr; gap: 70px; align-items: end; padding-top: 110px; padding-bottom: 78px; }
  .chapter-kicker { margin-bottom: 15px; color: var(--accent-dark); font-weight: 780; }
  .chapter-intro h2, .fit-section h2, .privacy-section h2, .closing h2 { font-size: clamp(3rem, 6vw, 5.4rem); line-height: .94; letter-spacing: -.035em; }
  .chapter-intro > p { color: var(--ink-soft); font-size: 1.08rem; line-height: 1.7; }
  .chapter { position: relative; min-height: 570px; padding: 56px 0; border-top: 1px solid var(--ink-faint); }
  .chapter-grid { position: relative; display: grid; grid-template-columns: .8fr 1fr; align-items: center; gap: clamp(48px, 10vw, 150px); }
  .chapter-reverse .chapter-grid { grid-template-columns: 1fr .8fr; }
  .chapter-reverse .chapter-copy { order: 2; }
  .chapter-name { margin-bottom: 18px; color: var(--accent-dark); font-weight: 780; }
  .chapter-copy h3 { max-width: 12ch; font-size: clamp(2.5rem, 5vw, 4.4rem); line-height: .96; letter-spacing: -.03em; }
  .chapter-copy > p:last-child { max-width: 38ch; margin-top: 22px; color: var(--ink-soft); font-size: 1.05rem; line-height: 1.7; }
  .screen-frame { justify-self: center; width: min(100%, 295px); padding: 7px; border-radius: 42px; background: var(--ink); box-shadow: var(--shadow); transform: rotate(-1.5deg); }
  .chapter-reverse .screen-frame { transform: rotate(1.5deg); }
  .screen-frame img { width: 100%; height: auto; border-radius: 35px; }
  .fit-section { padding: 130px 0; background: var(--paper); }
  .fit-grid { display: grid; grid-template-columns: 1fr .68fr; gap: 80px; }
  .fit-copy p { color: var(--ink-soft); font-size: 1.06rem; line-height: 1.75; }
  .fit-copy p + p { margin-top: 24px; padding-top: 24px; border-top: 1px solid var(--line); }
  .privacy-section { padding: 110px 0; background: var(--ink); color: var(--ink-on-dark); }
  .privacy-grid { display: grid; grid-template-columns: .5fr 1fr; gap: clamp(50px, 11vw, 150px); align-items: center; }
  .privacy-mark { width: min(100%, 330px); padding: 22px; border-radius: 72px; background: var(--field); box-shadow: var(--shadow); transform: rotate(-4deg); }
  .privacy-mark img { border-radius: 52px; }
  .privacy-section .chapter-kicker { color: var(--accent-soft); }
  .privacy-section p:not(.chapter-kicker) { max-width: 48ch; margin-top: 25px; color: color-mix(in srgb, var(--ink-on-dark) 78%, white); font-size: 1.08rem; line-height: 1.75; }
  .privacy-section .text-link { margin-top: 28px; color: var(--ink-on-dark); }
  .faq { display: grid; grid-template-columns: .7fr 1fr; gap: clamp(50px, 10vw, 140px); padding-top: 130px; padding-bottom: 130px; }
  .faq h2 { max-width: 8ch; font-size: clamp(3rem, 6vw, 5.4rem); line-height: .94; letter-spacing: -.035em; }
  .faq-list { border-top: 1px solid var(--line); }
  details { border-bottom: 1px solid var(--line); }
  summary { cursor: pointer; padding: 24px 42px 24px 0; font-family: var(--display); font-size: 1.18rem; font-weight: 740; }
  details p { max-width: 62ch; padding: 0 30px 24px 0; color: var(--ink-soft); line-height: 1.7; }
  .founder-note { padding: 110px 0; background: var(--blush); }
  .founder-grid { display: grid; grid-template-columns: 1.1fr .55fr; gap: 80px; align-items: end; }
  blockquote { max-width: 17ch; font-family: var(--display); font-size: clamp(2.5rem, 5vw, 4.6rem); font-weight: 750; line-height: 1; letter-spacing: -.03em; }
  .founder-grid p { color: var(--ink-soft); line-height: 1.75; }
  .founder-grid p + p { margin-top: 18px; }
  .closing { position: relative; overflow: hidden; min-height: 520px; padding: 120px 0; background: var(--field); }
  .closing .shell { position: relative; z-index: 1; display: grid; grid-template-columns: .65fr 1fr; gap: 70px; align-items: center; }
  .closing-lanterns { position: relative; min-height: 220px; }
  .closing-lanterns .lantern { filter: none; }
  .closing .button { margin-top: 32px; }
  @media (max-width: 900px) {
    .hero { min-height: 0; }
    .hero-grid { grid-template-columns: 1fr .67fr; gap: 34px; }
    .tension, .chapter-intro, .fit-grid, .faq, .founder-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 700px) {
    .hero { padding-top: 122px; padding-bottom: 0; }
    .hero-grid { grid-template-columns: 1fr; }
    h1 { font-size: clamp(3.6rem, 18vw, 5.4rem); }
    .hero-device { justify-self: end; width: min(58%, 205px); margin: 24px clamp(12px, 8vw, 32px) 0 0; }
    .tension { padding-top: 90px; padding-bottom: 90px; }
    .chapter-intro { padding-top: 88px; padding-bottom: 56px; }
    .chapter { min-height: 0; padding: 42px 0; }
    .chapter-grid, .chapter-reverse .chapter-grid { grid-template-columns: minmax(0, 1fr) minmax(112px, 34%); gap: 22px; }
    .chapter-reverse .chapter-copy { order: 2; }
    .screen-frame { width: 100%; max-width: 150px; }
    .privacy-grid, .closing .shell { grid-template-columns: 1fr; }
    .privacy-mark { width: 160px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .phone-shell, .screen-frame, .chapter-reverse .screen-frame, .privacy-mark { transform: none; }
  }
</style>
